<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="64dp" android:paddingTop="56dp"
    android:background="@drawable/bg_result">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_title" android:textSize="52sp" android:textColor="@color/ink_text"
                android:fontFamily="@font/sl_sans_black" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/consent_private"
                android:textSize="30sp" android:textColor="@color/ink_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/consent_optional"
                android:textSize="26sp" android:textColor="@color/ink_muted" />
        </LinearLayout>
        <io.github.ddayoung03.safetyleague.ui.view.RabbitView android:id="@+id/rabbit" android:layout_width="180dp" android:layout_height="245dp"
            android:layout_marginStart="24dp" />
    </LinearLayout>
    <TextView android:id="@+id/consent_current" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="24dp" android:textSize="24sp" android:textColor="@color/yellow"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
        android:layout_marginTop="32dp" android:orientation="horizontal">
        <Button android:id="@+id/btn_consent_allow" style="@style/DemoButton" android:layout_width="400dp"
            android:text="@string/consent_allow" android:textSize="30sp" android:textColor="@color/ink" />
        <Button android:id="@+id/btn_consent_deny" style="@style/DemoButton" android:layout_width="320dp"
            android:layout_marginStart="24dp" android:text="@string/consent_deny" />
    </LinearLayout>
</LinearLayout>
