<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/asphalt">
    <View android:layout_width="8dp" android:layout_height="220dp"
        android:layout_marginStart="64dp" android:layout_marginTop="128dp" android:background="@color/bronze" />
    <TextView android:id="@+id/placement_season" android:layout_width="1100dp" android:layout_height="48dp"
        android:layout_marginStart="64dp" android:layout_marginTop="56dp" android:textSize="28sp" android:textColor="@color/grey" />
    <TextView android:id="@+id/placement_model" android:layout_width="1080dp" android:layout_height="90dp"
        android:layout_marginStart="100dp" android:layout_marginTop="136dp" android:textSize="56sp"
        android:fontFamily="@font/pretendard_black" android:textColor="@color/white" android:maxLines="1"
        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="28sp" app:autoSizeMaxTextSize="56sp" />
    <TextView android:id="@+id/placement_tier" android:layout_width="1080dp" android:layout_height="80dp"
        android:layout_marginStart="100dp" android:layout_marginTop="236dp" android:textSize="44sp"
        android:textColor="@color/bronze" android:text="브론즈 단계에 배치되었습니다" />
    <io.github.ddayoung03.safetyleague.ui.view.CrewFaceView android:layout_width="100dp" android:layout_height="100dp"
        android:layout_marginStart="64dp" android:layout_marginTop="380dp" />
    <TextView android:layout_width="960dp" android:layout_height="100dp" android:gravity="center_vertical"
        android:layout_marginStart="188dp" android:layout_marginTop="380dp" android:text="첫 레이스를 시작해 볼까요?"
        android:textSize="32sp" android:textColor="@color/white" />
    <Button android:id="@+id/btn_start" style="@style/DemoButton" android:layout_width="440dp"
        android:layout_marginStart="64dp" android:layout_marginTop="540dp" android:text="시작하기"
        android:textSize="30sp" android:textColor="@color/asphalt" android:backgroundTint="@color/yellow" />
    <Button android:id="@+id/btn_change_vehicle" style="@style/DemoButton" android:layout_width="260dp"
        android:layout_marginStart="528dp" android:layout_marginTop="540dp" android:text="차종 변경" android:backgroundTint="@color/cell" />
    <TextView android:id="@+id/placement_recognition" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginStart="64dp" android:layout_marginTop="636dp" android:text="차량 정보로 확인했어요"
        android:textSize="24sp" android:textColor="@color/grey" />
</FrameLayout>
