<?xml version="1.0" encoding="utf-8"?>
<!-- 시안 D 리그. 왼쪽 내 순위, 오른쪽 타이밍 타워. 줄 등장과 탭 교체는 LeagueScreen이 맡는다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result">

    <View
        android:id="@+id/checker_strip"
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- 상단 헤더 및 탭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="24dp">

        <TextView
            android:id="@+id/btn_league_back"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginEnd="20dp"
            android:background="@color/ink_glow"
            android:clickable="true"
            android:contentDescription="결과로 돌아가기"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:tag="skew"
            android:text="결과"
            android:textColor="@color/ink_text"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_league_report"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginEnd="20dp"
            android:background="@color/ink_glow"
            android:clickable="true"
            android:contentDescription="주간 리포트 보기"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:tag="skew"
            android:text="리포트"
            android:textColor="@color/ink_text"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_season_title"
            android:text="11월 시즌 · 골드 리그"
            android:textColor="@color/ink_text"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:id="@+id/tv_days_left"
            android:text="21일 남음"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 탭. 색과 기울임은 LeagueScreen이 칠한다 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_tab_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="240dp"
                android:minHeight="76dp"
                android:paddingHorizontal="26dp"
                android:text="아이오닉 5"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_tab_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:minHeight="76dp"
                android:paddingHorizontal="26dp"
                android:text="부산"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_tab_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:minHeight="76dp"
                android:paddingHorizontal="26dp"
                android:text="친구"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 왼쪽 내 순위 및 안전운전 효용 -->
    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="116dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_rank_caption"
            android:text="내 순위 · 골드 리그 397명 중"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <!-- 줄 높이는 글자 크기의 1.574배(252dp)이고 글자는 그 가운데 0.69em만 쓴다. 위아래 여백이 곧 간격이라 상자를 겹치지 않는다 -->
        <TextView
            style="@style/NumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_big_rank"
            android:text="P125"
            android:textColor="@color/ink_text"
            android:textSize="160sp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:shadowColor="#01000000"
            android:shadowRadius="40"
            android:paddingEnd="40dp"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:id="@+id/tv_to_line"
            android:text="승급 라인까지 6계단 · 0.9점"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <!-- 티어 5칸 바. 색과 기울임은 LeagueScreen이 칠한다 -->
        <LinearLayout
            android:id="@+id/tier_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="브론즈"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="실버"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="골드"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="플래티넘"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="다이아"
                android:textSize="20sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 안전운전 효용 2칸. 오른쪽 128dp는 토끼 자리 -->
        <LinearLayout
            android:id="@+id/stats_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="128dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/ink_glow"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내가 아낀 돈"
                    android:textColor="@color/ink_muted"
                    android:textSize="19sp" />

                <TextView
                    style="@style/NumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_saved"
                    android:text="₩8,400"
                    android:textColor="@color/ink_text"
                    android:textSize="42sp"
                    android:includeFontPadding="false"
                    android:shadowColor="#01000000"
                    android:shadowRadius="9"
                    android:paddingEnd="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번 달"
                    android:textColor="@color/ink_muted"
                    android:textSize="19sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@color/ink_glow"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="리그가 줄인 급제동"
                    android:textColor="@color/ink_muted"
                    android:textSize="19sp" />

                <TextView
                    style="@style/NumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_brakes_cut"
                    android:text="3,120회"
                    android:textColor="@color/yellow"
                    android:textSize="42sp"
                    android:includeFontPadding="false"
                    android:shadowColor="#01000000"
                    android:shadowRadius="9"
                    android:paddingEnd="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_brakes_caption"
                    android:text="이번 주, 12% 감소"
                    android:textColor="@color/ink_muted"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 토끼 자리. 타워 옆 구석에서 승급 라인을 가리킨다. -->
    <io.github.ddayoung03.safetyleague.ui.view.RabbitView
        android:id="@+id/rabbit"
        android:layout_width="180dp"
        android:layout_height="245dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="486dp"
        android:layout_marginBottom="4dp" />

    <!-- 오른쪽 전체 순위 타워 -->
    <LinearLayout
        android:layout_width="560dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:paddingTop="108dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="순위"
                android:textColor="@color/ink_muted"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시즌 평균"
                android:textColor="@color/ink_muted"
                android:textSize="20sp" />
        </LinearLayout>

        <ScrollView
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layout_league_rows"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
