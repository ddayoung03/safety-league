<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt">

    <!-- 상단 연석 띠 -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="top"
        android:alpha="0.5" />

    <!-- 하단 연석 띠 -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_gravity="bottom"
        android:alpha="0.9" />

    <!-- 상단 헤더 및 탭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_season_title"
            android:text="11월 시즌 · 골드 리그"
            android:textColor="@color/white"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:id="@+id/tv_days_left"
            android:text="21일 남음"
            android:textColor="@color/grey"
            android:textSize="24sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 탭 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="skew"
        android:background="@color/white"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp"
                android:id="@+id/tv_tab_model"
                android:text="아이오닉 5"
                android:textColor="@color/asphalt"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:tag="skew"
        android:background="@color/cell"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp"
                android:text="부산"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:tag="skew"
        android:background="@color/cell"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp"
                android:text="친구"
                android:textColor="@color/grey"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 왼쪽 내 순위 및 안전운전 효용 -->
    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="128dp"
        android:paddingBottom="44dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_rank_caption"
            android:text="내 순위 · 골드 리그 397명 중"
            android:textColor="@color/grey"
            android:textSize="24sp" />

        <io.github.ddayoung03.safetyleague.ui.view.MetalTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_big_rank"
            android:text="P125"
            android:textColor="@color/white"
            android:textSize="200sp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:fontFamily="@font/saira_condensed"
            android:textStyle="italic"
            android:shadowColor="#01000000"
            android:shadowRadius="40"
            android:paddingEnd="40dp" 
            android:maxLines="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="skew"
        android:background="@color/yellow"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:id="@+id/tv_to_line"
            android:text="승급 라인까지 6계단 · 0.9점"
            android:textColor="@color/asphalt"
            android:textSize="28sp" />

        <!-- 티어 5칸 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="skew"
        android:background="@color/cell"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="브론즈"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:tag="skew"
        android:background="@color/cell"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="실버"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:tag="skew"
        android:background="@color/gold"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="골드"
                android:textColor="@color/asphalt"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:tag="skew"
        android:background="@color/cell"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="플래티넘"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:tag="skew"
        android:background="@color/cell"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="다이아"
                android:textColor="@color/grey"
                android:textSize="24sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 안전운전 효용 2칸 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/cell"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내가 아낀 돈"
                    android:textColor="@color/grey"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_saved"
                    android:text="₩8,400"
                    android:textColor="@color/white"
                    android:textSize="46sp"
                    android:fontFamily="@font/saira_condensed"
                    android:textStyle="italic"
                    android:shadowColor="#01000000"
                    android:shadowRadius="9"
                    android:paddingEnd="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번 달"
                    android:textColor="@color/grey"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@color/cell"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="리그가 줄인 급제동"
                    android:textColor="@color/grey"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_brakes_cut"
                    android:text="3,120회"
                    android:textColor="@color/yellow"
                    android:textSize="46sp"
                    android:fontFamily="@font/saira_condensed"
                    android:textStyle="italic"
                    android:shadowColor="#01000000"
                    android:shadowRadius="9"
                    android:paddingEnd="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_brakes_caption"
                    android:text="이번 주, 12% 감소"
                    android:textColor="@color/grey"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 오른쪽 전체 순위 타워 -->
    <LinearLayout
        android:layout_width="560dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:paddingTop="112dp"
        android:paddingBottom="44dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="순위"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시즌 평균"
                android:textColor="@color/grey"
                android:textSize="24sp" />
        </LinearLayout>

        <ScrollView
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layout_league_rows"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
