<?xml version="1.0" encoding="utf-8"?>
<!-- 시스템 권한 창 앞에 보여 주는 설명. 문구는 PermissionActivity의 permissionNotes가 채운다. -->
<!-- 별도 작업 창이라 메인 화면처럼 DesignCanvas로 1280×720 시안 배율을 맞춘다 -->
<io.github.ddayoung03.safetyleague.ui.view.DesignCanvas xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="64dp" android:paddingTop="56dp"
    android:background="@drawable/bg_result">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/permission_intro_title" android:textSize="52sp" android:textColor="@color/ink_text"
                android:fontFamily="@font/sl_sans_black" />
            <TextView android:id="@+id/tv_notes" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:textSize="28sp" android:textColor="@color/ink_text" />
        </LinearLayout>
        <io.github.ddayoung03.safetyleague.ui.view.RabbitView android:id="@+id/rabbit" android:layout_width="180dp" android:layout_height="245dp"
            android:layout_marginStart="24dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
        android:layout_marginTop="32dp" android:orientation="horizontal">
        <Button android:id="@+id/btn_continue" style="@style/DemoButton" android:layout_width="400dp"
            android:text="@string/permission_intro_continue" android:textSize="30sp" android:textColor="@color/ink" />
        <Button android:id="@+id/btn_later" style="@style/DemoButton" android:layout_width="320dp"
            android:layout_marginStart="24dp" android:text="@string/permission_intro_later" />
    </LinearLayout>
</LinearLayout>
</io.github.ddayoung03.safetyleague.ui.view.DesignCanvas>
