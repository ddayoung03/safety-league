<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt"
    android:clipChildren="false"
    android:clipToPadding="false">

    <io.github.ddayoung03.safetyleague.ui.view.CheckerFlagView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:alpha="0.85" />

    <!-- 상단 얇은 연석 띠 -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="top"
        android:alpha="0.5" />

    <!-- 하단 서킷 연석 띠 -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_gravity="bottom"
        android:alpha="0.9" />

    <!-- 주행 경로 배경 흐림 -->
    <io.github.ddayoung03.safetyleague.ui.view.CircuitRouteView
        android:id="@+id/route_bg"
        android:layout_width="720dp"
        android:layout_height="432dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="-70dp"
        android:layout_marginTop="110dp" />

    <!-- 왼쪽: 시안 좌표 그대로 (top 52 제목, top 96 점수 340, top 430 순위 띠, bottom 56 통계) -->
    <TextView
        android:id="@+id/tv_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="52dp"
        android:text="아이오닉 5 리그 · 오늘의 레이스 종료"
        android:textColor="@color/yellow"
        android:textSize="26sp" />

    <!-- 고득점 시 불꽃 모션 (점수 뒤) -->
    <io.github.ddayoung03.safetyleague.ui.view.FlameScoreView
        android:id="@+id/flame_score_view"
        android:layout_width="620dp"
        android:layout_height="380dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="70dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="78dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <io.github.ddayoung03.safetyleague.ui.view.MetalTextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.035"
            android:text="92"
            android:textColor="@color/white"
            android:textSize="300sp"
            android:fontFamily="@font/saira_condensed"
            android:textStyle="italic"
            android:shadowColor="#01000000"
            android:shadowRadius="68"
            android:paddingEnd="68dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="90dp"
            android:layout_marginStart="-20dp"
            android:text="점"
            android:textColor="@color/grey"
            android:textSize="72sp" />
    </LinearLayout>

    <!-- 순위 상승 · 승급 라인 띠 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="392dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_rank_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="skew"
        android:background="@color/red"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:text="▲3"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tv_to_promotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:tag="skew"
        android:background="@color/cell"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:text="승급 라인까지 6계단"
            android:textColor="@color/white"
            android:textSize="30sp" />
    </LinearLayout>

    <!-- 하단 통계 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="34dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연속 안전 주행"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="13일"
                android:textColor="@color/white"
                android:textSize="50sp"
                android:fontFamily="@font/saira_condensed"
                android:textStyle="italic"
                android:shadowColor="#01000000"
                android:shadowRadius="11"
                android:paddingEnd="11dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주행 거리"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="18.4km"
                android:textColor="@color/white"
                android:textSize="50sp"
                android:fontFamily="@font/saira_condensed"
                android:textStyle="italic"
                android:shadowColor="#01000000"
                android:shadowRadius="11"
                android:paddingEnd="11dp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/crew" android:layout_width="210dp" android:layout_height="350dp"
        android:layout_marginStart="444dp" android:layout_marginTop="346dp" android:layout_gravity="top|start"
        android:src="@drawable/crew_thumbs_up" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="372dp" android:layout_height="wrap_content"
        android:layout_marginStart="64dp" android:layout_marginTop="458dp" android:orientation="vertical"
        android:background="@drawable/radio_panel" android:elevation="6dp" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/radio_title" android:textSize="24sp" android:textColor="@color/yellow" />
        <TextView android:id="@+id/tv_radio_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/radio_praise" android:textSize="26sp" android:textColor="@color/white" />
    </LinearLayout>
    <!-- 오른쪽 순위 타워 -->
    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="100dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tv_season_label"
                android:text="11월 시즌 순위"
                android:textColor="@color/grey"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시즌 평균"
                android:textColor="@color/grey"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- 순위 줄 컨테이너 -->
        <LinearLayout
            android:id="@+id/layout_tower_rows"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 리플레이 보기 버튼 -->
        <FrameLayout
            android:id="@+id/btn_replay"
            android:tag="skew"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_gravity="end"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="40dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="리플레이 보기"
                    android:textColor="@color/asphalt"
                    android:textSize="24sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
