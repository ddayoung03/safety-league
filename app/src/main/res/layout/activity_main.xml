<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 시연 모드 전용 바. 평소에는 숨김 (왼쪽 위 모서리를 길게 누르면 열림) -->
    <HorizontalScrollView
        android:id="@+id/demo_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/ink_glow"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="88dp">

            <Button android:id="@+id/tab_result_win" style="@style/DemoButton" android:text="결과(이긴 날)" />
            <Button android:id="@+id/tab_result_low" style="@style/DemoButton" android:text="결과(아쉬운 날)" />
            <Button android:id="@+id/tab_replay" style="@style/DemoButton" android:text="리플레이" />
            <Button android:id="@+id/tab_home" style="@style/DemoButton" android:text="홈" />
            <Button android:id="@+id/tab_league" style="@style/DemoButton" android:text="리그" />
            <Button android:id="@+id/tab_report" style="@style/DemoButton" android:text="리포트" />
            <Button android:id="@+id/tab_driving" style="@style/DemoButton" android:text="주행 중" />
            <Button android:id="@+id/btn_weather" style="@style/DemoButton" android:text="@string/weather_button_sun" />
            <Button android:id="@+id/btn_settlement" style="@style/DemoButton" android:text="시즌 정산" />
            <Button android:id="@+id/btn_sim_win" style="@style/DemoButton" android:text="이긴 날 시연" />
            <Button android:id="@+id/tab_placement" style="@style/DemoButton" android:text="배치" />
            <Button android:id="@+id/btn_sim_low" style="@style/DemoButton" android:text="아쉬운 날 시연" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 탭이 표시되면 남은 공간에 시안 전체를 맞춘다. -->
    <io.github.ddayoung03.safetyleague.ui.view.DesignCanvas
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    </LinearLayout>

    <!-- 시연 모드 열고 닫기: 보이지 않는 76dp 모서리 -->
    <View
        android:id="@+id/demo_hotspot"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:contentDescription="시연 모드"
        android:importantForAccessibility="no" />

    <!-- 차량 SDK 연결 문제 표시 (시연 모드에서만) -->
    <TextView
        android:id="@+id/tv_sdk_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@color/ink_glow"
        android:padding="12dp"
        android:textColor="@color/ink_text"
        android:textSize="24sp"
        android:visibility="gone" />

    <!-- 체커기 로딩: 터치를 막지 않는다 -->
    <LinearLayout
        android:id="@+id/flag_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        android:visibility="gone">

        <io.github.ddayoung03.safetyleague.ui.view.RabbitView
            android:id="@+id/flag_loader_rabbit"
            android:layout_width="116dp"
            android:layout_height="150dp"
            android:layout_marginEnd="12dp" />

        <io.github.ddayoung03.safetyleague.ui.view.FlagLoaderView
            android:id="@+id/flag_loader_flag"
            android:layout_width="118dp"
            android:layout_height="92dp" />

        <TextView
            android:id="@+id/flag_loader_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/loader_tally"
            android:textColor="@color/ink_muted"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 시작 연출. 새로 시작할 때만 SplashIntro가 2초 동안 보이고 걷는다. 터치하면 바로 걷힌다. -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher_foreground" />

            <TextView
                android:id="@+id/splash_word"
                style="@style/NumberText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:letterSpacing="0.12"
                android:shadowColor="#01000000"
                android:shadowRadius="20"
                android:text="SAFETY LEAGUE"
                android:textColor="@color/ink_text"
                android:textSize="56sp" />

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="6dp"
                android:layout_marginTop="24dp"
                android:background="@color/ink_glow">

                <View
                    android:id="@+id/splash_bar"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:background="@color/yellow"
                    android:pivotX="0"
                    android:scaleX="0" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
