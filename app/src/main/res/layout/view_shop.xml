<?xml version="1.0" encoding="utf-8"?>
<!-- 토끼 피트샵. 왼쪽은 정비소 벽, 토끼, 카운터 앞면의 목표 게이지. 오른쪽은 상품과 쿠폰함. 내용은 ShopScreen이 채운다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <!-- 왼쪽: 토끼가 카운터 뒤에 서도록 카운터를 나중에 그린다 -->
    <FrameLayout
        android:layout_width="660dp"
        android:layout_height="match_parent"
        android:clipChildren="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="200dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/shop_garage" />

        <io.github.ddayoung03.safetyleague.ui.view.RabbitView
            android:id="@+id/rabbit"
            android:layout_width="620dp"
            android:layout_height="740dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="-21dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="34dp"
            android:background="@color/yellow"
            android:paddingHorizontal="30dp"
            android:paddingVertical="12dp"
            android:tag="skew"
            android:text="토끼 피트샵"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/bubble"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="354dp"
            android:layout_marginTop="24dp"
            android:background="@color/ink_text"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="토끼 정비사"
                android:textColor="@color/ink_muted"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tv_talk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- 카운터 앞면 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="bottom"
            android:background="@color/track_empty">

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/yellow" />

            <View
                android:id="@+id/counter_checker"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_goal_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="30dp"
                android:textColor="@color/ink_text"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_marginTop="64dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_balance"
                    style="@style/NumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="12dp"
                    android:textColor="@color/ink_text"
                    android:shadowColor="#01000000"
                    android:shadowRadius="16"
                    android:textSize="68sp" />

                <TextView
                    android:id="@+id/tv_goal_price"
                    style="@style/NumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="8dp"
                    android:textColor="@color/ink_muted"
                    android:shadowColor="#01000000"
                    android:shadowRadius="10"
                    android:textSize="34sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/goal_track"
                android:layout_width="588dp"
                android:layout_height="18dp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="158dp">

                <View
                    android:id="@+id/goal_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- 오른쪽 위 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="690dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_shop_back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:clickable="true"
            android:contentDescription="리그로 돌아가기"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:text="리그"
            android:textColor="@color/ink_text"
            android:textSize="22sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_tab_shop"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="상점"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_tab_coupons"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="690dp"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="72dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="694dp"
        android:layout_marginBottom="28dp"
        android:text="시연용 상품입니다. 실제 쿠폰은 발급되지 않아요."
        android:textColor="@color/ink_muted"
        android:textSize="19sp" />

    <!-- 교환 확인. 오른쪽만 덮어 토끼는 그대로 보인다 -->
    <LinearLayout
        android:id="@+id/confirm_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="660dp"
        android:background="@color/ink"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이 쿠폰으로 교환할까요?"
            android:textColor="@color/ink_muted"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_confirm_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink_text"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/tv_confirm_price"
            style="@style/NumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingEnd="28dp"
            android:textColor="@color/yellow"
            android:shadowColor="#01000000"
            android:shadowRadius="16"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/tv_confirm_after"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="48dp"
                android:text="교환하기"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/btn_confirm_cancel"
                android:layout_width="wrap_content"
                android:layout_height="76dp"
                android:layout_marginStart="20dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="40dp"
                android:text="취소"
                android:textColor="@color/ink_text"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
