<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow">

    <io.github.ddayoung03.safetyleague.ui.view.WeatherAmbientView
        android:id="@+id/weather_ambient" android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="480dp"
        android:layout_height="176dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="236dp"
        android:scaleType="fitCenter"
        android:src="@drawable/prop_car"
        android:importantForAccessibility="no" />

    <!-- 좌상단 주행 기록 중 인디케이터 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/shape_circle_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:id="@+id/tv_weather_status"
            android:text="@string/weather_recording_sun"
            android:textColor="@color/ink_muted"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- 중앙 타이틀 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="180dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sl_sans_black"
            android:text="오늘의 레이스 진행 중"
            android:textColor="@color/ink_text"
            android:textSize="84sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="결과는 주차하면 공개돼요"
            android:textColor="@color/ink_muted"
            android:textSize="30sp" />
    </LinearLayout>

    <!-- 하단 1km 트랙 프로그레스 및 자동차 아이콘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp"
        android:layout_marginHorizontal="80dp"
        android:orientation="vertical">

        <!-- 3km 자격 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="3km부터 기록 인정"
            android:textColor="@color/ink_muted"
            android:textSize="24sp" />

        <!-- 1km 프로그레스 칸 바 -->
        <io.github.ddayoung03.safetyleague.ui.view.DrivingTrackView
            android:id="@+id/layout_track_bar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:importantForAccessibility="no" />

        <!-- 하단 메타 정보 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tv_progress"
                android:text="11.2 / 18.4km · 해운대까지"
                android:textColor="@color/ink_text"
                android:textSize="32sp"
                android:fontFamily="@font/saira_condensed"
                android:textStyle="italic"
                android:shadowColor="#01000000"
                android:shadowRadius="6"
                android:paddingEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_goal"
                android:text="@string/driving_goal"
                android:textColor="@color/yellow"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
