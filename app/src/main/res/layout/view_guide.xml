<?xml version="1.0" encoding="utf-8"?>
<!-- 안전 가이드. 왼쪽 카드 목록, 오른쪽 행동 순서. 주차 중에만 열린다. 내용은 GuideScreen이 채운다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result"
    android:clipChildren="false">

    <View
        android:id="@+id/checker_strip"
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp">

        <TextView
            android:id="@+id/btn_guide_back"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:clickable="true"
            android:contentDescription="리그로 돌아가기"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:text="리그"
            android:textColor="@color/ink_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:text="안전 가이드"
            android:textColor="@color/ink_text"
            android:textSize="34sp" />

        <LinearLayout
            android:id="@+id/guide_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <ScrollView
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:layout_marginTop="132dp"
        android:layout_marginBottom="32dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 오른쪽: 고른 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="544dp"
        android:layout_marginTop="132dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_guide_icon"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_guide_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_text"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/tv_guide_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/yellow"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_guide_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="210dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ink_muted"
            android:textSize="19sp" />
    </LinearLayout>

    <io.github.ddayoung03.safetyleague.ui.view.RabbitView
        android:id="@+id/rabbit"
        android:layout_width="220dp"
        android:layout_height="302dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="20dp" />
</FrameLayout>
