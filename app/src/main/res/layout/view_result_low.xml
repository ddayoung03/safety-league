<?xml version="1.0" encoding="utf-8"?>
<!-- 아쉬운 날 결과 카드. 시안 mockups/result-low.html 좌표(1280×720dp 캔버스) 그대로. 빨강 없음. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 회색 연석 띠 (위 얇게, 아래 굵게) -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:id="@+id/kerb_top"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="top"
        android:alpha="0.5" />

    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:id="@+id/kerb_bottom"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_gravity="bottom"
        android:alpha="0.9" />

    <!-- 주행 경로 배경 흐림 -->
    <io.github.ddayoung03.safetyleague.ui.view.CircuitRouteView
        android:id="@+id/route_bg"
        android:layout_width="720dp"
        android:layout_height="432dp"
        android:layout_marginStart="-30dp"
        android:layout_marginTop="110dp" />

    <TextView
        android:id="@+id/tv_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="52dp"
        android:text="아이오닉 5 리그 · 오늘의 레이스 종료"
        android:textColor="@color/grey"
        android:textSize="30sp" />

    <!-- 비 모션 (점수 뒤) -->
    <io.github.ddayoung03.safetyleague.ui.view.RainScoreView
        android:id="@+id/rain_score_view"
        android:layout_width="620dp"
        android:layout_height="320dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="80dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="78dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <io.github.ddayoung03.safetyleague.ui.view.MetalTextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.035"
            android:text="64"
            android:textColor="@color/grey"
            android:textSize="300sp"
            android:fontFamily="@font/saira_condensed"
            android:textStyle="italic"
            android:shadowColor="#01000000"
            android:shadowRadius="68"
            android:paddingEnd="68dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="90dp"
            android:layout_marginStart="-20dp"
            android:text="점"
            android:textColor="@color/grey"
            android:textSize="72sp" />
    </LinearLayout>

    <FrameLayout android:id="@+id/crew" android:layout_width="221dp" android:layout_height="380dp" android:layout_marginStart="436dp" android:layout_marginTop="70dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="32dp"
            android:src="@drawable/crew_pit_board" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tv_pit_word" android:layout_width="169dp" android:layout_height="77dp"
            android:layout_marginStart="26dp" android:layout_marginTop="210dp" android:gravity="center"
            android:text="@string/pit_signal" android:fontFamily="@font/pretendard_black" android:textSize="34sp" android:textColor="@color/asphalt_deep" />
    </FrameLayout>

    <!-- 피트 보드: 다음에 고칠 것 하나 -->
    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="468dp"
        android:background="@drawable/pit_panel"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <io.github.ddayoung03.safetyleague.ui.view.CrewFaceView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/pit_title" android:textColor="@color/asphalt" android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pit_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:text="차선 바꿀 때 깜빡이부터 켜기"
            android:textColor="@color/asphalt"
            android:textSize="36sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:background="@color/asphalt" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pit_reason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="오늘 깜빡이 없이 차선 변경 4회"
                android:textColor="@color/asphalt"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_pit_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매너 +9점 가능"
                android:textColor="@color/asphalt"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 오른쪽: 순위 타워 → 리플레이 보기 → 통계 -->
    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="64dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tv_season_label"
                android:text="11월 시즌 순위"
                android:textColor="@color/grey"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시즌 평균"
                android:textColor="@color/grey"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_tower_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_league"
                android:tag="skew"
                android:layout_width="wrap_content"
                android:layout_height="76dp"
                android:layout_marginEnd="16dp"
                android:background="@color/cell"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="리그 순위"
                    android:textColor="@color/white"
                    android:textSize="26sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_replay"
                android:tag="skew"
                android:layout_width="wrap_content"
                android:layout_height="76dp"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="40dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="리플레이 보기"
                        android:textColor="@color/asphalt"
                        android:textSize="24sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연속 안전 주행 (70점 이상)"
                    android:textColor="@color/grey"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_streak_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="13일 → 0일"
                    android:textColor="@color/grey"
                    android:textSize="48sp"
                    android:fontFamily="@font/saira_condensed"
                    android:textStyle="italic"
                    android:shadowColor="#01000000"
                    android:shadowRadius="10"
                    android:paddingEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다음 주행 70점이면 1일부터 다시"
                    android:textColor="@color/yellow"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주행 거리"
                    android:textColor="@color/grey"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="22.1km"
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:fontFamily="@font/saira_condensed"
                    android:textStyle="italic"
                    android:shadowColor="#01000000"
                    android:shadowRadius="10"
                    android:paddingEnd="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_demo_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="20dp"
        android:text="다른 날의 예시"
        android:textColor="@color/grey"
        android:textSize="24sp" />

</FrameLayout>
