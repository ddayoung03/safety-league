<?xml version="1.0" encoding="utf-8"?>
<!-- 아쉬운 날 결과 카드. 이긴 날과 같은 시안 D 가족이고 더 조용하다. 빨강·신호등·속도선 없음.
     이 파일의 기본 상태가 최종 상태다. 연출은 ResultMotion이 잠시 숨겼다 되돌린다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/checker_strip"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:alpha="0.35" />

    <!-- 주행 경로 배경 흐림 -->
    <io.github.ddayoung03.safetyleague.ui.view.CircuitRouteView
        android:id="@+id/route_bg"
        android:layout_width="720dp"
        android:layout_height="432dp"
        android:layout_marginStart="-30dp"
        android:layout_marginTop="110dp" />

    <TextView
        android:id="@+id/tv_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:layout_marginTop="60dp"
        android:text="아이오닉 5 리그 · 오늘의 레이스 종료"
        android:textColor="@color/ink_muted"
        android:textSize="22sp" />

    <!-- 글꼴의 윗여백이 커서 상자는 위로 올라가 있다. 기준선은 위에서 363dp. 너비는 fixScoreWidth가 숫자에 맞춘다. -->
    <LinearLayout
        android:id="@+id/score_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:layout_marginTop="66dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_score"
            style="@style/NumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.82"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="64"
            android:textColor="@color/ink_text"
            android:textSize="262sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-44dp"
            android:text="점"
            android:textColor="@color/ink_muted"
            android:textSize="44sp" />
    </LinearLayout>

    <io.github.ddayoung03.safetyleague.ui.view.RabbitView android:id="@+id/rabbit" android:layout_width="270dp" android:layout_height="380dp" android:layout_marginStart="419dp" android:layout_marginTop="70dp" />

    <!-- 피트 보드: 다음에 고칠 것 하나. 머리글은 팀 라디오 알약이다. -->
    <LinearLayout
        android:id="@+id/pit_board"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:layout_marginTop="460dp"
        android:background="@drawable/pit_panel"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/radio_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="22dp">

            <io.github.ddayoung03.safetyleague.ui.view.RabbitHeadView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pit_title"
                android:textColor="@color/ink_text"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pit_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:text="차선 바꿀 때 깜빡이부터 켜기"
            android:textColor="@color/ink"
            android:textSize="36sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="@color/ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pit_reason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="오늘 깜빡이 없이 차선 변경 4회"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_pit_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매너 +25점 가능"
                android:textColor="@color/ink"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 오른쪽 순위 타워와 통계 -->
    <LinearLayout
        android:layout_width="530dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="60dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_season_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_season_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="11월 시즌 순위"
                android:textColor="@color/ink_muted"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시즌 평균"
                android:textColor="@color/ink_muted"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_tower_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_tower_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="18dp"
            android:textColor="@color/yellow"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/stats_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연속 안전 주행 (70점 이상)"
                    android:textColor="@color/ink_muted"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_streak_change"
                    style="@style/NumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="10dp"
                    android:shadowColor="#01000000"
                    android:shadowRadius="10"
                    android:text="13일 → 0일"
                    android:textColor="@color/ink_text"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tv_streak_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다음 주행 70점이면 1일부터 다시"
                    android:textColor="@color/yellow"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주행 거리"
                    android:textColor="@color/ink_muted"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_km"
                    style="@style/NumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="10dp"
                    android:shadowColor="#01000000"
                    android:shadowRadius="10"
                    android:text="22.1km"
                    android:textColor="@color/ink_text"
                    android:textSize="40sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="60dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_league"
            android:layout_width="180dp"
            android:layout_height="76dp"
            android:layout_marginEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="리그 순위"
                android:textColor="@color/ink_text"
                android:textSize="24sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_replay"
            android:layout_width="330dp"
            android:layout_height="76dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="리플레이 보기"
                android:textColor="@color/ink"
                android:textSize="24sp" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_demo_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="20dp"
        android:text="다른 날의 예시"
        android:textColor="@color/ink_muted"
        android:textSize="20sp" />

</FrameLayout>
