<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt">

    <!-- 상단 연석 띠 -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="top"
        android:alpha="0.5" />

    <!-- 하단 연석 띠 -->
    <io.github.ddayoung03.safetyleague.ui.view.KerbView
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_gravity="bottom"
        android:alpha="0.9" />

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_report_title"
            android:text="11월 2주차 리포트"
            android:textColor="@color/white"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:id="@+id/tv_report_range"
            android:text="11.03 ~ 11.09 · 주행 6일"
            android:textColor="@color/grey"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 왼쪽 주간 평균 점수 및 막대 그래프 -->
    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="118dp"
        android:paddingBottom="130dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이번 주 평균 점수"
            android:textColor="@color/grey"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_week_avg"
                android:text="88.8"
                android:textColor="@color/white"
                android:textSize="150sp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:fontFamily="@font/saira_condensed"
                android:textStyle="italic"
                android:shadowColor="#01000000"
                android:shadowRadius="30"
                android:paddingEnd="30dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:tag="skew"
        android:background="@color/yellow"
                android:paddingHorizontal="18dp"
                android:paddingVertical="6dp"
                android:id="@+id/tv_week_change"
                android:text="지난주보다 +3.1"
                android:textColor="@color/asphalt"
                android:textSize="30sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_last_week"
            android:text="지난주 85.7점"
            android:textColor="@color/grey"
            android:textSize="24sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 요일별 점수 막대 그래프 -->
        <LinearLayout
            android:id="@+id/layout_score_bars"
            android:layout_width="520dp"
            android:layout_height="230dp"
            android:gravity="bottom"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 오른쪽 포지션 차트 -->
    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:paddingTop="118dp"
        android:paddingBottom="130dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="순위 변동 · 골드 리그"
                android:textColor="@color/grey"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_rank_move"
                android:text="P131 → P125 ▲6"
                android:textColor="@color/yellow"
                android:textSize="24sp" />
        </LinearLayout>

        <io.github.ddayoung03.safetyleague.ui.view.PositionChartView
            android:id="@+id/position_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- 하단 피트 보드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="36dp"
        android:layout_marginHorizontal="64dp"
        android:tag="skew"
        android:background="@color/cell"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 주 작전"
            android:textColor="@color/yellow"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:id="@+id/tv_next_plan"
            android:text="깜빡이 누락만 줄이면 승급 라인까지 6계단, 평균 +0.9점이면 돼요"
            android:textColor="@color/white"
            android:textSize="26sp" />
    </LinearLayout>

</FrameLayout>
