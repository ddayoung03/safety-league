<?xml version="1.0" encoding="utf-8"?>
<!-- 점수 상세. 다섯 항목의 점수와 이유. 줄은 ScoreDetailScreen이 채운다. 주차 중에만 열린다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result">

    <View
        android:id="@+id/checker_strip"
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="40dp">

        <FrameLayout
            android:id="@+id/btn_back"
            android:contentDescription="결과로 돌아가기"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:background="@color/ink_glow"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:tag="skew">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="결과로"
                    android:textColor="@color/ink_text"
                    android:textSize="24sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="점수 상세"
            android:textColor="@color/ink_text"
            android:textSize="34sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_total"
            style="@style/NumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingEnd="12dp"
            android:shadowColor="#01000000"
            android:shadowRadius="12"
            android:textColor="@color/ink_text"
            android:textSize="60sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="점"
            android:textColor="@color/ink_muted"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:orientation="vertical"
        android:paddingHorizontal="64dp">

        <TextView
            android:id="@+id/tv_score_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_muted"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
